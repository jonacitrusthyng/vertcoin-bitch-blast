<Window x:Class="VertcoinOcm.GalleryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Emi’s gallery · Vertcoin Bitch Blast! Edition"
 Icon="{StaticResource MinerIcon}" Width="1220" Height="820" MinWidth="760" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="#050B0E" Foreground="#EAFBF5"
 FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="GalleryKeyDown" Closed="GalleryClosed">
 <Window.Resources>
  <Style x:Key="GalleryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#E811252B"/><Setter Property="Foreground" Value="#D8FFF0"/>
   <Setter Property="BorderBrush" Value="#497D79"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,0,7,7"/>
  </Style>
  <Style x:Key="HudLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#A2E4DE"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="HudCard" TargetType="Border">
   <Setter Property="Background" Value="#CF07171D"/><Setter Property="BorderBrush" Value="#52978A"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,6"/>
   <Setter Property="CornerRadius" Value="5"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="GalleryRoot">
  <Border IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center=".5,.4" GradientOrigin=".5,.4" RadiusX=".8" RadiusY=".8"><GradientStop Color="#173039"/><GradientStop Color="#03080C" Offset="1"/></RadialGradientBrush></Border.Background></Border>
  <Image x:Name="GalleryImage" Stretch="Uniform" MouseLeftButtonDown="ImageMouseDown" AutomationProperties.Name="Gallery picture"/>
  <TextBlock x:Name="ImageError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="450" TextAlignment="Center" FontSize="20" Background="#E807171D" Padding="20"/>

  <Border VerticalAlignment="Top" Margin="20,14,20,0" Background="#CF07171D" BorderBrush="#65D9B5" BorderThickness="0,0,0,1" Padding="11,6" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=TelemetryHud}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="BITCH BLAST // FLIGHT DECK" FontSize="10" FontWeight="Bold" Foreground="#9BF7C7"/><TextBlock x:Name="HudState" Text="Miner idle · awaiting status" FontSize="12" Margin="0,2,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <TextBlock Grid.Column="1" Text="LIVE MINER STATS" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
    </Grid>
  </Border>

  <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,17">
  <Grid x:Name="TelemetryHud" Margin="0,0,0,8" IsHitTestVisible="False">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource HudCard}"><StackPanel><TextBlock Text="HASHRATE" Style="{StaticResource HudLabel}"/><TextBlock x:Name="HudHashrate" Text="— kH/s" FontSize="22" FontWeight="SemiBold" Foreground="#A4FFD0" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource HudCard}"><StackPanel><TextBlock Text="WORKER SHARES" Style="{StaticResource HudLabel}"/><TextBlock x:Name="HudShares" Text="— accepted" FontSize="18" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HudRejected" Text="No worker data yet" Foreground="#BDDDD6" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Grid.Column="4" Style="{StaticResource HudCard}"><StackPanel><TextBlock Text="AI / GPU SHARING" Style="{StaticResource HudLabel}"/><TextBlock x:Name="HudAi" Text="Awaiting status" FontSize="16" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="Mining yields when Auto is on" Foreground="#BDDDD6" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="1" Background="#CF07171D" BorderBrush="#52978A" BorderThickness="1" CornerRadius="5" Padding="11,5" Margin="0,6,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock x:Name="HudPool" Text="POOL // Not selected" Foreground="#C0EEE0" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="HudNode" Grid.Column="2" Text="NODE // Not connected" Foreground="#B6DFEE" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Border>
  </Grid>

  <Border x:Name="GalleryControlPanel" Background="#DE07171D" BorderBrush="#65BAAC" BorderThickness="1" CornerRadius="8" Padding="13,9,6,3">
   <StackPanel>
    <Grid Margin="0,0,7,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="ImageTitle" Text="Emi’s gallery" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="HudSong" Text="MUSIC // Choose a song in the jukebox" FontSize="11" Foreground="#ABCFC9" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="ImageCount" Text="0 / 0" FontFamily="Consolas" FontSize="13" Foreground="#9BF7C7" HorizontalAlignment="Right"/><TextBlock Text="F11 fullscreen · Esc return" Foreground="#A9CAC6" FontSize="10" Margin="10,4,0,0"/></StackPanel>
    </Grid>
    <WrapPanel>
     <Button x:Name="PreviousImageButton" Content="◀ Previous" Click="PreviousImageClick" Style="{StaticResource GalleryButton}" AutomationProperties.Name="Previous gallery picture"/>
     <Button x:Name="NextImageButton" Content="Next ▶" Click="NextImageClick" Style="{StaticResource GalleryButton}" AutomationProperties.Name="Next gallery picture"/>
     <Button x:Name="SlideshowButton" Content="Slideshow: off" Click="SlideshowClick" Style="{StaticResource GalleryButton}" ToolTip="Change pictures every 12 seconds. Music playback is independent."/>
     <Button x:Name="HudButton" Content="Hide HUD" Click="HudClick" Style="{StaticResource GalleryButton}"/>
     <Button x:Name="FullScreenButton" Content="⛶ Fullscreen" Click="FullScreenClick" Style="{StaticResource GalleryButton}" ToolTip="F11 or double-click the picture. Escape returns to the resizable window."/>
     <Button x:Name="GalleryMusicButton" Content="▶ Music" Click="MusicClick" Style="{StaticResource GalleryButton}" AutomationProperties.Name="Play or pause jukebox music"/>
     <Button x:Name="GalleryMuteButton" Content="Mute all" Click="MuteClick" Style="{StaticResource GalleryButton}"/>
     <Button Content="Back to miner" Click="BackClick" Style="{StaticResource GalleryButton}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  </StackPanel>
 </Grid>
</Window>
